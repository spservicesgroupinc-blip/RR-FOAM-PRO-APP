# ──────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env.local for local development
# ──────────────────────────────────────────────────────────────────────────────
# These variables are baked into the Vite JS bundle at build time.
# Never commit real values — use GitHub Actions secrets for CI/CD.

# Supabase project URL (found in: Supabase dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public API key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# (Optional) Google Gemini API key
GEMINI_API_KEY=your-gemini-api-key
